# Environment Variables Example
# Duplicate this file to .env or .env.local and replace values with actual credentials

# DATABASE CONNECTIONS
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# SECURITY & SECRETS
JWT_SECRET=your_fallback_secret_key_for_development_32_chars_minimum
NODE_ENV=development

# ADMINISTRATIVE SEED DEFAULTS
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@dashboard.com
ADMIN_PASSWORD=Password123
MOBILE=9999999999
